 namespace knf {

+namespace {
+
+void AlfredWipeFloatData(float *data, size_t count) {
+  if (data == nullptr || count == 0) return;
+#if defined(__APPLE__)
+  (void)memset_s(data, count * sizeof(float), 0, count * sizeof(float));
+#else
+  volatile float *p = data;
+  for (size_t i = 0; i != count; ++i) p[i] = 0.0f;
+#endif
+}
+
+void AlfredWipeFloatVector(std::vector<float> *v) {
+  if (v == nullptr || v->empty()) return;
+  AlfredWipeFloatData(v->data(), v->size());
+}
+
+}  // namespace
+
