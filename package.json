    "setup": "node scripts/install.mjs"
  },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/pablomanjarres/Alfred.git" }
